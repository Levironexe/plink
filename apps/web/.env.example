# Copy to .env.local and fill in. Everything below is optional except the core block —
# each integration degrades gracefully when its key is absent.

# Core ────────────────────────────────────────────────────────
# Postgres. On Neon use the pooled host (ends in -pooler) and sslmode=verify-full.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"
# Direct (non-pooled) host — only needed if migrations ever fail through the pooler.
DATABASE_URL_UNPOOLED=""
AUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe — product checkout, tips, Pro subscriptions, creator payouts
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_VIP_MONTHLY=""
STRIPE_PRICE_VIP_YEARLY=""
STRIPE_PLATFORM_FEE_BPS="500"

# Resend — password reset, email verification, audience broadcasts
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_REPLY_TO=""

# Vercel Blob — avatar, banner, block image and digital product uploads
BLOB_READ_WRITE_TOKEN=""

# Vercel AI Gateway — AI page builder and copy generation
AI_GATEWAY_API_KEY=""
