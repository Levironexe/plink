{
  "name": "plink",
  "version": "0.1.0",
  "private": true,
  "description": "A link-in-bio creator platform — monorepo root.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:all": "turbo run typecheck lint test test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @plink/db db:migrate",
    "db:deploy": "pnpm --filter @plink/db db:deploy",
    "db:studio": "pnpm --filter @plink/db db:studio",
    "db:seed": "pnpm --filter @plink/db db:seed",
    "db:reset": "pnpm --filter @plink/db db:reset",
    "setup": "pnpm --filter @plink/db setup"
  },
  "devDependencies": {
    "turbo": "^2.6.4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
