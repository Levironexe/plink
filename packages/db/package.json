{
  "name": "@plink/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./generated/client.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "setup": "prisma migrate deploy && prisma generate && tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "clean": "rm -rf generated node_modules"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@plink/core": "workspace:*",
    "@plink/eslint-config": "workspace:*",
    "@plink/typescript-config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
