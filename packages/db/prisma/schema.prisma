// Plink — a link-in-bio creator platform.
// Postgres everywhere — Neon in development and production alike.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  username      String   @unique
  displayName   String
  bio           String   @default("")
  avatarUrl     String?
  bannerUrl     String?
  verified      Boolean  @default(false)
  category      String?
  location      String?
  onboarded     Boolean  @default(false)
  plan          String   @default("free") // free | pro | vip
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Email verification
  emailVerified   DateTime?

  // Stripe — billing (platform charges the creator) and Connect (creator gets paid)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  planStatus           String   @default("active") // active | past_due | canceled | trialing
  planInterval         String?  // month | year
  planRenewsAt         DateTime?
  stripeAccountId      String?  @unique
  payoutsEnabled       Boolean  @default(false)

  // Custom domain
  customDomain     String?  @unique
  domainVerifiedAt DateTime?
  domainToken      String?

  theme         Theme?
  blocks        Block[]
  socials       SocialLink[]
  products      Product[]
  subscribers   Subscriber[]
  pageViews     PageView[]
  clicks        ClickEvent[]
  orders        Order[]
  mediaKit      MediaKit?
  sessions      Session[]
  tokens        VerificationToken[]
  broadcasts    Broadcast[]
  bookings      Booking[]
  availability  Availability[]
  invoices      Invoice[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use tokens for email verification and password reset.
model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String // verify_email | reset_password
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Theme {
  id             String  @id @default(cuid())
  userId         String  @unique
  presetId       String  @default("moonlight")
  bgType         String  @default("gradient") // solid | gradient | image | pattern
  bgColor        String  @default("#0f0c29")
  bgColorTwo     String  @default("#302b63")
  bgImageUrl     String?
  bgPattern      String  @default("none")
  textColor      String  @default("#ffffff")
  mutedColor     String  @default("#c9c6e0")
  accentColor    String  @default("#7c5cff")
  buttonStyle    String  @default("fill")   // fill | outline | soft | shadow | glass
  buttonRadius   String  @default("full")   // none | sm | md | lg | full
  buttonColor    String  @default("#ffffff")
  buttonTextColor String @default("#111111")
  fontFamily     String  @default("inter")
  avatarShape    String  @default("circle") // circle | rounded | square
  hideBranding   Boolean @default(false)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Block {
  id        String   @id @default(cuid())
  userId    String
  type      String   // link | header | text | image | video | socials | email | tipjar | product | divider | gallery | faq | calendar | music
  title     String   @default("")
  subtitle  String   @default("")
  url       String   @default("")
  imageUrl  String?
  config    String   @default("{}") // JSON blob for type specific settings
  position  Int      @default(0)
  visible   Boolean  @default(true)
  highlight Boolean  @default(false)
  clicks    Int      @default(0)

  /// Scheduling — block is hidden outside this window when set.
  startsAt  DateTime?
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    ClickEvent[]

  @@index([userId, position])
}

model SocialLink {
  id       String @id @default(cuid())
  userId   String
  platform String
  url      String
  position Int    @default(0)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Product {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  priceCents  Int      @default(0)
  currency    String   @default("USD")
  imageUrl    String?
  fileUrl     String?
  type        String   @default("digital") // digital | service | membership | tip
  published   Boolean  @default(true)
  sales       Int      @default(0)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId])
}

model Order {
  id         String   @id @default(cuid())
  userId     String
  productId  String?
  email      String
  amountCents Int
  status     String   @default("paid") // pending | paid | refunded | failed
  createdAt  DateTime @default(now())

  /// Stripe Checkout reconciliation
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  /// Signed, expiring download grant for digital goods
  downloadToken         String? @unique

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Subscriber {
  id        String   @id @default(cuid())
  userId    String
  email     String
  name      String   @default("")
  source    String   @default("page")
  unsubscribedAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId])
}

/// An email campaign sent to a creator's subscriber list via Resend.
model Broadcast {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  body        String   @default("")
  status      String   @default("draft") // draft | sending | sent | failed
  recipients  Int      @default(0)
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Weekly recurring availability window backing the calendar block.
model Availability {
  id        String @id @default(cuid())
  userId    String
  weekday   Int    // 0 = Sunday … 6 = Saturday
  startMin  Int    // minutes from midnight, local to `timezone`
  endMin    Int
  timezone  String @default("UTC")
  slotMins  Int    @default(30)

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekday])
}

/// A booked appointment against an Availability window.
model Booking {
  id          String   @id @default(cuid())
  userId      String
  name        String
  email       String
  note        String   @default("")
  startsAt    DateTime
  endsAt      DateTime
  status      String   @default("confirmed") // confirmed | canceled
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
}

/// Creator-issued invoice for brand deals and freelance work.
model Invoice {
  id          String   @id @default(cuid())
  userId      String
  number      String
  clientName  String
  clientEmail String
  items       String   @default("[]") // JSON array of { description, quantity, unitCents }
  currency    String   @default("USD")
  notes       String   @default("")
  status      String   @default("draft") // draft | sent | paid | void
  dueAt       DateTime?
  sentAt      DateTime?
  paidAt      DateTime?
  totalCents  Int      @default(0)
  stripeSessionId String? @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, number])
  @@index([userId, createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  userId    String
  referrer  String   @default("direct")
  country   String   @default("Unknown")
  device    String   @default("desktop")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ClickEvent {
  id        String   @id @default(cuid())
  userId    String
  blockId   String?
  referrer  String   @default("direct")
  device    String   @default("desktop")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  block     Block?   @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([blockId])
}

model MediaKit {
  id          String  @id @default(cuid())
  userId      String  @unique
  headline    String  @default("")
  about       String  @default("")
  rateCard    String  @default("[]")  // JSON array
  audience    String  @default("{}")  // JSON object
  brands      String  @default("[]")  // JSON array
  published   Boolean @default(false)

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
