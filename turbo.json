{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "**/.env.*local",
    "**/.env"
  ],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "AUTH_SECRET",
    "NEXT_PUBLIC_SITE_URL",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "STRIPE_PRICE_PRO_MONTHLY",
    "STRIPE_PRICE_PRO_YEARLY",
    "STRIPE_PRICE_VIP_MONTHLY",
    "STRIPE_PRICE_VIP_YEARLY",
    "STRIPE_PLATFORM_FEE_BPS",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "RESEND_REPLY_TO",
    "BLOB_READ_WRITE_TOKEN",
    "AI_GATEWAY_API_KEY"
  ],
  "tasks": {
    "topo": {
      "dependsOn": [
        "^topo"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^topo",
        "^build",
        "db:generate"
      ]
    },
    "lint": {
      "dependsOn": [
        "^topo"
      ]
    },
    "test": {
      "dependsOn": [
        "^topo",
        "db:generate"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "cache": false,
      "outputs": [
        "playwright-report/**"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
